{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "global-shortcut:allow-unregister-all",
    "autostart:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "window-state:default"
  ]
}